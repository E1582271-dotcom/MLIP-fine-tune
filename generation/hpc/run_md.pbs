#!/bin/bash
# Li6PS5Cl MLIP-MD on one GPU: generation/md/run_md.py inside the container (generation/hpc/run_in_container.sh).
# Container, package trees and modules come from generation/hpc/site.env (copy generation/hpc/site.env.example).
# Submit from the repository root and add site-specific qsub options (project, queue) yourself.
# TEMPS uses '_' as separator because qsub -v splits on commas. The resource request is the one the
# July runs used (one A40 GPU). Walltimes: 48 h (416 atoms, 200 ps) and 24 h (Cl-excess) are the
# recorded ones; the 150-ps value is only a sufficient one (about 1.5 h per temperature on an A40).
# Equilibration lengths are the ones printed in the July job logs (generation/README.md, step 2).
#
#   smoke test:             qsub -v MLIP=mace,TEMPS=800,STEPS=2000,EQUILIB=500,LOG_EVERY=20 generation/hpc/run_md.pbs
#   52 atoms, 50 ps:        qsub -v MLIP=mace,TEMPS=600_800_1000,STEPS=50000,EQUILIB=5000 generation/hpc/run_md.pbs
#                           (MLIP=mattersim for MatterSim; likewise for 100 and 150 ps)
#   52 atoms, 100 ps:       qsub -v MLIP=mace,TEMPS=600_800_1000,STEPS=100000,EQUILIB=5000,TRAJ_TAG=_100ps generation/hpc/run_md.pbs
#   52 atoms, 150 ps:       qsub -l walltime=24:00:00 -v MLIP=mace,TEMPS=600_800_1000,STEPS=150000,EQUILIB=5000,TRAJ_TAG=_long generation/hpc/run_md.pbs
#   416-atom production, one job per temperature (MLIP=mattersim with TRAJ_TAG=_prod_ms):
#     for T in 600 800 1000; do
#       qsub -l walltime=48:00:00 -v MLIP=mace,TEMPS=$T,STEPS=200000,EQUILIB=10000,SUPERCELL_TAG=_sc222,TRAJ_TAG=_prod generation/hpc/run_md.pbs
#     done
#   fine-tuned models: as production with
#     TRAJ_TAG=_ft,MACE_MODEL=generation/output/finetune/models/li6ps5cl_ft_stagetwo.model (Gamma labels) or
#     TRAJ_TAG=_ft27k,MACE_MODEL=generation/output/finetune/models/li6ps5cl_ft27k.model (2x2x2 labels)
#   Cl-excess series (MACE-MP-0 small), one job per composition and temperature:
#     for D in cl100 cl125 cl150 cl175; do for T in 600 800 1000; do
#       qsub -l walltime=24:00:00 -v MLIP=mace,TEMPS=$T,STEPS=150000,EQUILIB=10000,CIF=data/structures/doped_${D}_sc222.cif,TRAJ_TAG=_dope_$D generation/hpc/run_md.pbs
#     done; done
#PBS -N li6_md
#PBS -l select=1:ngpus=1:ncpus=36:mem=240gb
#PBS -l walltime=04:00:00
#PBS -j oe

set -eo pipefail
cd "$PBS_O_WORKDIR"
source generation/hpc/site.env
MLIP="${MLIP:-mace}"
if [ "$MLIP" = "mattersim" ]; then PKG_BASE="$MATTERSIM_PKG_BASE"; else PKG_BASE="$MACE_PKG_BASE"; fi
echo "[pbs] host=$(hostname) start=$(date)"
echo "[pbs] MLIP=$MLIP TEMPS=${TEMPS:-800} STEPS=${STEPS:-2000} EQUILIB=${EQUILIB:-500} TRAJ_TAG=${TRAJ_TAG:-}"

if [ -n "${CONTAINER_MODULE:-}" ]; then module load "$CONTAINER_MODULE"; fi
RUN=()   # empty CONTAINER_IMAGE: run on the host
# shellcheck disable=SC2206  # CONTAINER_EXEC and CONTAINER_GPU_FLAG may hold several words
if [ -n "${CONTAINER_IMAGE:-}" ]; then RUN=($CONTAINER_EXEC $CONTAINER_GPU_FLAG "$CONTAINER_IMAGE"); fi
"${RUN[@]}" env \
  MLIP="$MLIP" TEMPS="${TEMPS:-800}" STEPS="${STEPS:-2000}" EQUILIB="${EQUILIB:-500}" \
  LOG_EVERY="${LOG_EVERY:-50}" SUPERCELL_TAG="${SUPERCELL_TAG:-}" TRAJ_TAG="${TRAJ_TAG:-}" \
  MACE_MODEL="${MACE_MODEL:-small}" CIF="${CIF:-}" PKG_BASE="$PKG_BASE" PKG_PYTHON="${PKG_PYTHON:-python3.10}" \
  bash generation/hpc/run_in_container.sh
echo "[pbs] end=$(date)"
