# Site configuration sourced by generation/hpc/run_md.pbs, generation/finetune/finetune_mace.pbs and
# generation/labels/label_qe.pbs. Copy to generation/hpc/site.env (ignored by git) and edit. Nothing
# here is needed to rebuild the tables or figures of this repository.

# --- GPU container (MD and fine-tuning) --------------------------------------------------------
# The July runs used a PyTorch 2.5 / CUDA 12.4 container image (Python 3.10) on one NVIDIA A40.
CONTAINER_MODULE=singularity                  # environment module providing the runtime; empty: none
CONTAINER_EXEC="singularity exec"             # or "apptainer exec"
CONTAINER_GPU_FLAG=""                         # e.g. "--nv"; empty where the site exposes GPUs itself
CONTAINER_IMAGE=/path/to/pytorch_2.5_cuda_12.4.sif   # empty: run on the host without a container

# Python packages installed with `PYTHONUSERBASE=<dir> python3 -m pip install --user ...` against the
# container's Python, one tree per potential so that their dependencies never clash.
MACE_PKG_BASE=/path/to/macepkg                # mace-torch 0.3.16 and ase (MD with MACE, fine-tuning)
MATTERSIM_PKG_BASE=/path/to/mattersimpkg      # mattersim and ase (MD with MatterSim)
PKG_PYTHON=python3.10                         # trees hold lib/<PKG_PYTHON>/site-packages

# MACE-MP-0 small for fine-tuning: "small" downloads it; on offline compute nodes point this at a
# copy fetched beforehand (an absolute path). The July runs used the mace cache file
# 20231210mace128L0_energy_epoch249model, i.e. 2023-12-10-mace-128-L0_energy_epoch-249.model, the
# file behind "small".
MACE_FOUNDATION=small

# --- CPU DFT labelling (generation/labels/label_qe.pbs) ------------------------------------------
QE_MODULE=QuantumESPRESSO/7.1-intel-2022a     # module providing pw.x and mpirun (QE 7.1, Intel MPI)
LABEL_PYTHON=python3                          # a Python with ase, outside the container
