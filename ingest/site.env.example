# Site settings of ingest/reanalyse_series.pbs. Copy to ingest/site.env (ignored by git) and edit.
ANALYSIS_ENV_TAR=/path/to/analysis_python_env.tar   # standalone Python 3.11 with requirements-ingest packages
ANALYSIS_ENV_SHA256=""                              # optional checksum of the tar
ANALYSIS_ENV_PYTHON=analysispkg/python/bin/python3  # interpreter inside the unpacked tar
RAW_DIR=/path/to/raw/backup                         # layout of data/raw_manifest.csv
CONTAINER_IMAGE=""                                  # empty: run on the host (needs a compatible glibc)
CONTAINER_EXEC="singularity exec"
CONTAINER_BINDS="--bind /path/to/project/filesystem"
